# Required for live Jev.
# Get a key: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Without a key, scoring is disabled unless you opt into the keyword mock.
# TALLY_ALLOW_MOCK=1

# Optional TypeSafe overrides
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# PORT=8788

# EventSub (optional). IRC connect works with only a channel name.
# Create an app at https://dev.twitch.tv/console/apps
# Redirect URI: http://127.0.0.1:8788/api/twitch/callback
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://127.0.0.1:8788/api/twitch/callback
